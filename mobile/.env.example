# Client-side (bundled in the app — must use EXPO_PUBLIC_ prefix)
# For physical Android devices, set EXPO_PUBLIC_DEVICE_HOST in .env.local
# to your Mac's local IP (e.g. EXPO_PUBLIC_DEVICE_HOST=192.168.1.50)
# or Bonjour hostname (e.g. EXPO_PUBLIC_DEVICE_HOST=MacBook-Pro.local)
EXPO_PUBLIC_BETTER_AUTH_URL=http://localhost:3001/api/auth
EXPO_PUBLIC_GO_BACKEND_URL=http://localhost:8080/api/v1

# Unity Ads identifiers (real values live in .env / EAS build profiles, NOT here).
# lib/ads.ts falls back to the real IDs hardcoded as defaults, so these vars are
# optional overrides. See docs/ads.md for the full tracking checklist.
# EXPO_PUBLIC_UNITY_GAME_ID_ANDROID=800417099
# EXPO_PUBLIC_UNITY_GAME_ID_IOS=800417100
# EXPO_PUBLIC_UNITY_BANNER_PLACEMENT_ANDROID=BP_Banner_Android
# EXPO_PUBLIC_UNITY_BANNER_PLACEMENT_IOS=BP_Banner_IOS
# EXPO_PUBLIC_UNITY_INTERSTITIAL_PLACEMENT_ANDROID=BP_Interstitial_Android
# EXPO_PUBLIC_UNITY_INTERSTITIAL_PLACEMENT_IOS=BP_Interstitial_IOS
